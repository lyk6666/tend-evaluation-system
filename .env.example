# Provider settings. Keep the real key only in .env.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
TEND_EVAL_MODEL=gpt-5.6-luna
TEND_EVAL_REASONING_EFFORT=medium
TEND_EVAL_LLM_STUB=0
TEND_EVAL_PROVIDER_MAX_RETRIES=5

# Schema-index embeddings. The provider key falls back to OPENAI_API_KEY when omitted.
TEND_EVAL_EMBEDDING_API_KEY=
TEND_EVAL_EMBEDDING_MODEL=text-embedding-3-small
TEND_EVAL_EMBEDDING_BASE_URL=https://api.openai.com/v1
TEND_EVAL_EMBEDDING_BATCH_SIZE=64

# Local services and official TEND checkout.
MONGODB_URI=mongodb://127.0.0.1:27017
TEND_EVAL_MONGO_MAX_TIME_MS=120000
TEND_SOURCE_DIR=../TEND_QueryCraft
TEND_RELEASE_DIR=../TEND_QueryCraft/release/tend-native-mongodb-v1

# Evaluation service defaults.
TEND_EVAL_DEFAULT_CONCURRENCY=4
TEND_EVAL_FRONTEND_ORIGIN=http://127.0.0.1:5173
TEND_EVAL_RUNTIME_DIR=data/runtime
